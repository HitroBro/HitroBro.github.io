---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hitarth Ghia — Cyber Security Student | Network Engineering & Security Automation" description="Cyber Security Student (CoE Track) at Parul University. Building high-concurrency network systems in C, security automation in Python, and interactive network demos.">

  <!-- Hero Section -->
  <section class="section" style="padding-top: calc(var(--header-height) + 4rem); padding-bottom: 4rem;">
    <div class="container">
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.5rem 1rem; background: var(--accent-primary-dim); border: 1px solid var(--accent-primary); border-radius: 9999px; font-size: 0.875rem; font-weight: 500; color: var(--accent-primary); margin-bottom: 1.5rem;">
          <span class="pulse-dot"></span>
          <span>Open to Internships & Research Opportunities</span>
        </div>

        <h1 style="margin-bottom: 1.5rem;">
          Building Secure,<br>
          <span class="text-accent">High-Performance</span><br>
          Network Systems
        </h1>

        <p style="font-size: 1.25rem; color: var(--fg-secondary); max-width: 640px; margin: 0 auto 2.5rem; line-height: 1.7;">
          Cyber Security Student (CoE Track) specializing in <strong>Network Infrastructure</strong> and <strong>Security Automation</strong>.
          I write C systems code (epoll, timerfd, signalfd) for high-concurrency gateways, Python tooling for network automation,
          and interactive demos for protocol visualization.
        </p>

        <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-bottom: 3rem;">
          <a href="/projects/" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
              <line x1="12" y1="22.08" x2="12" y2="12"></line>
            </svg>
            View Projects
          </a>
          <a href="/blog/" class="btn btn-secondary">Technical Blog</a>
          <a href="/demos/" class="btn btn-ghost">Interactive Demos</a>
        </div>

        <!-- Tech Stack Badges -->
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; opacity: 0.8;">
          <span class="tag tag-primary">C11</span>
          <span class="tag tag-primary">epoll</span>
          <span class="tag tag-primary">timerfd</span>
          <span class="tag tag-primary">signalfd</span>
          <span class="tag">Python</span>
          <span class="tag">Linux</span>
          <span class="tag">TCP/IP</span>
          <span class="tag">Wireshark</span>
          <span class="tag">CCNA</span>
          <span class="tag">eBPF</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats Bar -->
  <section style="background: var(--bg-secondary); border-top: 1px solid var(--border-primary); border-bottom: 1px solid var(--border-primary); padding: 2.5rem 0;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; text-align: center;">
        <div>
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent-primary); font-family: var(--font-mono);" id="stat-repos">8</div>
          <div style="color: var(--fg-muted); font-size: 0.9rem; margin-top: 0.25rem;">Repositories</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent-primary); font-family: var(--font-mono);" id="stat-languages">6</div>
          <div style="color: var(--fg-muted); font-size: 0.9rem; margin-top: 0.25rem;">Languages</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent-primary); font-family: var(--font-mono);" id="stat-projects">4</div>
          <div style="color: var(--fg-muted); font-size: 0.9rem; margin-top: 0.25rem;">Major Projects</div>
        </div>
        <div>
          <div style="font-size: 2.5rem; font-weight: 700; color: var(--accent-primary); font-family: var(--font-mono);" id="stat-focus">1</div>
          <div style="color: var(--fg-muted); font-size: 0.9rem; margin-top: 0.25rem;">Focus: NetSec</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Featured Projects</h2>
        <p class="section-subtitle">Production-grade systems demonstrating network engineering depth and security automation breadth</p>
      </header>

      <div class="grid grid-3">
        <!-- async-tcp-gateway -->
        <article class="card">
          <div class="card-header">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
              <div>
                <span class="tag tag-primary mb-2">C Systems</span>
                <h3 class="card-title">Async TCP Layer 4 Gateway</h3>
              </div>
              <div style="width: 48px; height: 48px; background: var(--accent-primary-dim); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1"/>
                  <rect x="14" y="3" width="7" height="7" rx="1"/>
                  <rect x="3" y="14" width="7" height="7" rx="1"/>
                  <rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
              </div>
            </div>
          </div>
          <div class="card-body">
            <p class="card-description">High-concurrency asynchronous Layer 4 TCP gateway/proxy using epoll. Features round-robin load balancing, instant failover, async health checks with auto-recovery, IPv6 dual-stack, token bucket rate limiting, and SIGUSR1 metrics observability.</p>
          </div>
          <div class="card-footer">
            <div class="tag-list">
              <span class="tag">C11</span>
              <span class="tag">epoll</span>
              <span class="tag">timerfd</span>
              <span class="tag">signalfd</span>
              <span class="tag">Python Tests</span>
            </div>
            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
              <a href="/projects/async-tcp-gateway/" class="btn btn-primary btn-sm">Case Study</a>
              <a href="https://github.com/HitroBro/async-tcp-gateway" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Source</a>
            </div>
          </div>
        </article>

        <!-- NeoShare -->
        <article class="card">
          <div class="card-header">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
              <div>
                <span class="tag tag-primary mb-2">Network Security</span>
                <h3 class="card-title">NeoShare Local Cloud</h3>
              </div>
              <div style="width: 48px; height: 48px; background: var(--accent-primary-dim); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
              </div>
            </div>
          </div>
          <div class="card-body">
            <p class="card-description">Zero-dependency HTTP file server built from scratch with Python stdlib. Threaded architecture, directory traversal protection, 2GB upload limit, HTTP Range streaming for video, auto tar.gz folder downloads, and auto dark/light theme detection.</p>
          </div>
          <div class="card-footer">
            <div class="tag-list">
              <span class="tag">Python 3</span>
              <span class="tag">ThreadingHTTPServer</span>
              <span class="tag">Zero Deps</span>
              <span class="tag">Range Requests</span>
            </div>
            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
              <a href="/projects/neosahre/" class="btn btn-primary btn-sm">Case Study</a>
              <a href="https://github.com/HitroBro/NeoShare-Local-Cloud" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Source</a>
            </div>
          </div>
        </article>

        <!-- Modern-YTDLP-GUI -->
        <article class="card">
          <div class="card-header">
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
              <div>
                <span class="tag tag-primary mb-2">Automation</span>
                <h3 class="card-title">Modern-YTDLP-GUI</h3>
              </div>
              <div style="width: 48px; height: 48px; background: var(--accent-primary-dim); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; color: var(--accent-primary); flex-shrink: 0;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="23 7 16 12 23 17 23 7"></polygon>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              </div>
            </div>
          </div>
          <div class="card-body">
            <p class="card-description">Multi-threaded desktop GUI for yt-dlp with custom Modern UI engine. Non-blocking I/O, real-time progress, format selection, playlist handling, and embedded ffmpeg — all in a responsive dark-themed interface.</p>
          </div>
          <div class="card-footer">
            <div class="tag-list">
              <span class="tag">Python</span>
              <span class="tag">Threading</span>
              <span class="tag">yt-dlp</span>
              <span class="tag">Custom UI</span>
            </div>
            <div style="display: flex; gap: 0.75rem; margin-top: 1rem;">
              <a href="/projects/modern-ytdlp-gui/" class="btn btn-primary btn-sm">Case Study</a>
              <a href="https://github.com/HitroBro/Modern-YTDLP-GUI" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">Source</a>
            </div>
          </div>
        </article>
      </div>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/projects/" class="btn btn-secondary">View All Projects →</a>
      </div>
    </div>
  </section>

  <!-- Interactive Demos Preview -->
  <section class="section" style="background: var(--bg-secondary);">
    <div class="container">
      <header class="section-header">
        <h2 class="section-title">Interactive Network Demos</h2>
        <p class="section-subtitle">Browser-based tools for learning and debugging network protocols — no installation required</p>
      </header>

      <div class="grid grid-3">
        <a href="/demos/subnet-calculator/" class="card" style="text-decoration: none; color: inherit; display: block;">
          <div class="card-body" style="padding: 2rem; text-align: center;">
            <div style="width: 64px; height: 64px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--accent-primary);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.5rem;">Subnet Calculator</h3>
            <p style="color: var(--fg-secondary); font-size: 0.9rem; margin-bottom: 1rem;">CIDR notation, network/broadcast addresses, usable hosts, wildcard mask, binary visualization</p>
            <div class="tag-list" style="justify-content: center;">
              <span class="tag tag-primary">IPv4/IPv6</span>
              <span class="tag">CIDR</span>
              <span class="tag">Binary View</span>
            </div>
          </div>
        </a>

        <a href="/demos/packet-header-viz/" class="card" style="text-decoration: none; color: inherit; display: block;">
          <div class="card-body" style="padding: 2rem; text-align: center;">
            <div style="width: 64px; height: 64px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--accent-primary);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.5rem;">Packet Header Visualizer</h3>
            <p style="color: var(--fg-secondary); font-size: 0.9rem; margin-bottom: 1rem;">Interactive Ethernet/IPv4/TCP/UDP header breakdown with bit-level field editing and real-time checksum calculation</p>
            <div class="tag-list" style="justify-content: center;">
              <span class="tag tag-primary">Ethernet</span>
              <span class="tag">IPv4</span>
              <span class="tag">TCP/UDP</span>
            </div>
          </div>
        </a>

        <a href="/demos/tcp-state-machine/" class="card" style="text-decoration: none; color: inherit; display: block;">
          <div class="card-body" style="padding: 2rem; text-align: center;">
            <div style="width: 64px; height: 64px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--accent-primary);">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="17 1 21 5 17 9"></polyline>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                <polyline points="7 23 3 19 7 15"></polyline>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.5rem;">TCP State Machine</h3>
            <p style="color: var(--fg-secondary); font-size: 0.9rem; margin-bottom: 1rem;">Visual state diagram (LISTEN → SYN_SENT → SYN_RCVD → ESTABLISHED → FIN_WAIT → TIME_WAIT) with packet flow animation</p>
            <div class="tag-list" style="justify-content: center;">
              <span class="tag tag-primary">RFC 793</span>
              <span class="tag">Animation</span>
              <span class="tag">Educational</span>
            </div>
          </div>
        </a>
      </div>

      <div style="text-align: center; margin-top: 2.5rem;">
        <a href="/demos/" class="btn btn-primary">Explore All Demos →</a>
      </div>
    </div>
  </section>

  <!-- About / Contact -->
  <section class="section" id="contact">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; max-width: var(--container-max);">
        <div>
          <header class="section-header" style="text-align: left; margin-bottom: 2rem;">
            <h2 class="section-title" style="justify-content: flex-start;">Let's Connect</h2>
            <p class="section-subtitle" style="text-align: left; margin: 0;">Open to internships, research collaborations, and networking with fellow security engineers</p>
          </header>

          <div style="display: flex; flex-direction: column; gap: 1rem;">
            <a href="mailto:ghiahitarth@gmail.com" class="btn btn-primary" style="justify-content: flex-start; width: fit-content;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Email Me
            </a>
            <a href="https://linkedin.com/in/hitarth-ghia" target="_blank" rel="noopener" class="btn btn-secondary" style="justify-content: flex-start; width: fit-content;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
            <a href="https://github.com/HitroBro" target="_blank" rel="noopener" class="btn btn-ghost" style="justify-content: flex-start; width: fit-content;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
              GitHub
            </a>
          </div>

          <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border-primary);">
            <h4 style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg-muted); margin-bottom: 1rem;">Currently</h4>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.9rem; color: var(--fg-secondary);">
              <li><strong>🔭 Building:</strong> Async TCP gateway with eBPF/XDP integration</li>
              <li><strong>🧠 Studying:</strong> Linux kernel networking, BPF verifier, io_uring</li>
              <li><strong>📜 Pursuing:</strong> CCNA certification, OSCP prep</li>
            </ul>
          </div>
        </div>

        <div style="background: var(--bg-card); border: 1px solid var(--border-primary); border-radius: var(--radius-xl); padding: 2rem;">
          <h3 style="margin-bottom: 1.5rem;">Quick Contact</h3>
          <form id="contact-form" style="display: flex; flex-direction: column; gap: 1rem;">
            <div>
              <label for="name" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--fg-secondary);">Name</label>
              <input type="text" id="name" name="name" required style="width: 100%; padding: 0.75rem 1rem; background: var(--bg-tertiary); border: 1px solid var(--border-primary); border-radius: var(--radius-md); color: var(--fg-primary); font-family: var(--font-sans); font-size: 0.95rem; transition: border-color var(--transition-fast);" placeholder="Your name" />
            </div>
            <div>
              <label for="email" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--fg-secondary);">Email</label>
              <input type="email" id="email" name="email" required style="width: 100%; padding: 0.75rem 1rem; background: var(--bg-tertiary); border: 1px solid var(--border-primary); border-radius: var(--radius-md); color: var(--fg-primary); font-family: var(--font-sans); font-size: 0.95rem; transition: border-color var(--transition-fast);" placeholder="you@example.com" />
            </div>
            <div>
              <label for="subject" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--fg-secondary);">Subject</label>
              <select id="subject" name="subject" required style="width: 100%; padding: 0.75rem 1rem; background: var(--bg-tertiary); border: 1px solid var(--border-primary); border-radius: var(--radius-md); color: var(--fg-primary); font-family: var(--font-sans); font-size: 0.95rem; transition: border-color var(--transition-fast);">
                <option value="">Select a topic</option>
                <option value="internship">Internship Opportunity</option>
                <option value="research">Research Collaboration</option>
                <option value="networking">Technical Discussion</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" style="display: block; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; color: var(--fg-secondary);">Message</label>
              <textarea id="message" name="message" rows="4" required style="width: 100%; padding: 0.75rem 1rem; background: var(--bg-tertiary); border: 1px solid var(--border-primary); border-radius: var(--radius-md); color: var(--fg-primary); font-family: var(--font-sans); font-size: 0.95rem; transition: border-color var(--transition-fast); resize: vertical;" placeholder="Tell me about your project, role, or question..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary" style="width: 100%;">Send Message</button>
            <p id="form-status" style="font-size: 0.85rem; color: var(--fg-muted); text-align: center; min-height: 1.25rem;"></p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Pulse animation -->
  <style>
    .pulse-dot {
      width: 8px;
      height: 8px;
      background: var(--accent-primary);
      border-radius: 50%;
      animation: pulse 2s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(0.8); }
    }
    @media (prefers-reduced-motion: reduce) {
      .pulse-dot { animation: none; }
    }
  </style>

  <!-- Form handling -->
  <script>
    (function() {
      const form = document.getElementById('contact-form');
      const status = document.getElementById('form-status');
      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const original = btn.textContent;
        btn.textContent = 'Sending...';
        btn.disabled = true;
        status.textContent = '';
        status.style.color = 'var(--fg-muted)';

        const data = new FormData(form);
        const params = new URLSearchParams();
        for (const [key, value] of data) params.append(key, value);

        try {
          // Using Formspree or similar - replace with your endpoint
          const response = await fetch('https://formspree.io/f/your-form-id', {
            method: 'POST',
            body: params,
            headers: { 'Accept': 'application/json' }
          });
          if (response.ok) {
            status.textContent = '✓ Message sent successfully! I\'ll get back to you soon.';
            status.style.color = 'var(--accent-primary)';
            form.reset();
          } else {
            throw new Error('Form submission failed');
          }
        } catch {
          status.textContent = '✗ Failed to send. Please email directly: ghiahitarth@gmail.com';
          status.style.color = 'var(--accent-secondary)';
        } finally {
          btn.textContent = original;
          btn.disabled = false;
        }
      });

      // Focus styles
      form.querySelectorAll('input, select, textarea').forEach(el => {
        el.addEventListener('focus', () => el.style.borderColor = 'var(--accent-primary)');
        el.addEventListener('blur', () => el.style.borderColor = 'var(--border-primary)');
      });
    })();
  </script>
</BaseLayout>