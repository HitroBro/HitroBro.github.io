      categories: ['Networking', 'C', 'epoll', 'Systems Programming']
    },
    {
      title: 'Zero-Copy Networking in Linux: io_uring vs epoll',
      link: '/blog/io-uring-vs-epoll/',
      pubDate: new Date('2024-07-15'),
      description: 'Comparing the classic epoll approach with the new io_uring interface for high-performance packet processing.',
      categories: ['Systems', 'Linux', 'io_uring', 'epoll']
    },
    {
      title: 'Directory Traversal to RCE: Hardening Python HTTP Servers',
      link: '/blog/hardening-python-http/',
      pubDate: new Date('2024-06-20'),
      description: 'A walkthrough of common path traversal vulnerabilities in custom file servers, and the defense-in-depth approach used in NeoShare.',
      categories: ['Security', 'Python', 'HTTP', 'Hardening']
    },
    {
      title: 'TCP State Machine Visualized: From SYN to TIME_WAIT',
