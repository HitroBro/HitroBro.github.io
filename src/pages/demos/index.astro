---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Interactive Network Demos" description="Browser-based interactive tools for network engineering: Subnet Calculator, Packet Header Visualizer, TCP State Machine. Built with vanilla JavaScript, no frameworks." canonical="/demos/">

  <section class="section" style="padding-top: calc(var(--header-height) + 3rem);">
    <div class="container">
      <header class="section-header">
        <h1 class="section-title">Interactive Network Demos</h1>
        <p class="section-subtitle">Browser-based tools for learning and debugging network protocols — no installation required</p>
      </header>

      <div class="grid grid-3">
        <!-- Subnet Calculator -->
        <a href="/demos/subnet-calculator/" class="card" style="text-decoration: none; color: inherit; display: block; height: 100%;">
          <div class="card-body" style="padding: 2.5rem; display: flex; flex-direction: column; height: 100%;">
            <div style="width: 72px; height: 72px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--accent-primary);">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7" rx="1"/>
                <rect x="14" y="3" width="7" height="7" rx="1"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <rect x="14" y="14" width="7" height="7" rx="1"/>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.75rem;">Subnet Calculator</h3>
            <p style="color: var(--fg-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
              Calculate network addresses, broadcast addresses, usable host ranges, wildcard masks, and binary representations for both IPv4 and IPv6. Supports CIDR notation and classful addressing.
            </p>
            <div class="tag-list">
              <span class="tag tag-primary">IPv4/IPv6</span>
              <span class="tag">CIDR</span>
              <span class="tag">Binary View</span>
              <span class="tag">Classful</span>
            </div>
            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-primary); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted);">
              <span>Try it →</span>
            </div>
          </div>
        </a>

        <!-- Packet Header Visualizer -->
        <a href="/demos/packet-header-viz/" class="card" style="text-decoration: none; color: inherit; display: block; height: 100%;">
          <div class="card-body" style="padding: 2.5rem; display: flex; flex-direction: column; height: 100%;">
            <div style="width: 72px; height: 72px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--accent-primary);">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.75rem;">Packet Header Visualizer</h3>
            <p style="color: var(--fg-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
              Interactive Ethernet II, IPv4, TCP, and UDP header breakdown. Click any field to edit values in real-time with automatic checksum recalculation. Hex/decimal/binary view toggle.
            </p>
            <div class="tag-list">
              <span class="tag tag-primary">Ethernet II</span>
              <span class="tag">IPv4</span>
              <span class="tag">TCP/UDP</span>
              <span class="tag">Checksum</span>
            </div>
            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-primary); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted);">
              <span>Try it →</span>
            </div>
          </div>
        </a>

        <!-- TCP State Machine -->
        <a href="/demos/tcp-state-machine/" class="card" style="text-decoration: none; color: inherit; display: block; height: 100%;">
          <div class="card-body" style="padding: 2.5rem; display: flex; flex-direction: column; height: 100%;">
            <div style="width: 72px; height: 72px; background: var(--accent-primary-dim); border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: center; margin-bottom: 1.5rem; color: var(--accent-primary);">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="17 1 21 5 17 9"></polyline>
                <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
                <polyline points="7 23 3 19 7 15"></polyline>
                <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
              </svg>
            </div>
            <h3 style="margin-bottom: 0.75rem;">TCP State Machine</h3>
            <p style="color: var(--fg-secondary); font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; flex-grow: 1;">
              Visual RFC 793 state diagram with animated packet flows. Click states to see valid transitions, packet sequences, and timing. Covers LISTEN, SYN_SENT, SYN_RCVD, ESTABLISHED, FIN_WAIT_1/2, CLOSE_WAIT, LAST_ACK, TIME_WAIT, CLOSED.
            </p>
            <div class="tag-list">
              <span class="tag tag-primary">RFC 793</span>
              <span class="tag">Animation</span>
              <span class="tag">Educational</span>
              <span class="tag">Packet Flow</span>
            </div>
            <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--border-primary); display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted);">
              <span>Try it →</span>
            </div>
          </div>
        </a>
      </div>

      <!-- Coming Soon -->
      <div style="margin-top: 4rem; text-align: center;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1rem;">Coming Soon</h2>
        <p style="color: var(--fg-secondary); margin-bottom: 2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
          More interactive demos in development for network protocol learning and debugging
        </p>
        <div class="grid grid-4" style="max-width: 800px; margin: 0 auto; opacity: 0.6;">
          <div class="card" style="padding: 1.5rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">📊</div>
            <h4 style="margin-bottom: 0.5rem;">Port Scanner</h4>
            <p style="font-size: 0.85rem; color: var(--fg-muted);">TCP SYN/Connect scanner</p>
          </div>
          <div class="card" style="padding: 1.5rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🔐</div>
            <h4 style="margin-bottom: 0.5rem;">TLS Inspector</h4>
            <p style="font-size: 0.85rem; color: var(--fg-muted);">Certificate chain viewer</p>
          </div>
          <div class="card" style="padding: 1.5rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">🌐</div>
            <h4 style="margin-bottom: 0.5rem;">DNS Visualizer</h4>
            <p style="font-size: 0.85rem; color: var(--fg-muted);">Query trace + records</p>
          </div>
          <div class="card" style="padding: 1.5rem; text-align: center;">
            <div style="font-size: 2rem; margin-bottom: 0.5rem;">⚡</div>
            <h4 style="margin-bottom: 0.5rem;">Bandwidth Test</h4>
            <p style="font-size: 0.85rem; color: var(--fg-muted);">Client-side throughput</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>