---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="TCP State Machine — Interactive Network Demo" description="Visual RFC 793 TCP state diagram with animated packet flows. Covers all 11 states: CLOSED, LISTEN, SYN_SENT, SYN_RCVD, ESTABLISHED, FIN_WAIT_1, FIN_WAIT_2, CLOSE_WAIT, LAST_ACK, TIME_WAIT, CLOSING." canonical="/demos/tcp-state-machine/" type="article">

  <section class="section" style="padding-top: calc(var(--header-height) + 2rem);">
    <div class="container">
      <header style="max-width: 1100px; margin: 0 auto 2rem; text-align: center;">
        <a href="/demos/" class="btn btn-ghost btn-sm" style="margin-bottom: 1rem; align-self: flex-start;">← Back to Demos</a>
        <h1 style="margin-bottom: 1rem;">TCP State Machine</h1>
        <p style="color: var(--fg-secondary); font-size: 1.1rem;">Interactive RFC 793 state diagram with animated packet flows — all 11 states</p>
      </header>

      <div style="max-width: 1200px; margin: 0 auto;">
        <!-- Controls -->
        <div class="card" style="margin-bottom: 2rem; padding: 1.5rem;">
          <h3 style="margin-bottom: 1rem;">Controls</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center;">
            <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
              <button id="btn-active-open" class="btn btn-primary">Active Open (Client)</button>
              <button id="btn-passive-open" class="btn btn-secondary">Passive Open (Server)</button>
              <button id="btn-send-fin" class="btn btn-secondary">Send FIN</button>
              <button id="btn-recv-fin" class="btn btn-ghost">Receive FIN</button>
              <button id="btn-timeout" class="btn btn-ghost">Simulate Timeout</button>
              <button id="btn-reset" class="btn btn-ghost">Reset</button>
            </div>
            <div style="margin-left: auto; display: flex; align-items: center; gap: 1rem; color: var(--fg-muted); font-size: 0.9rem;">
              <label style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="checkbox" id="auto-animate" checked> Auto-animate
              </label>
              <label style="display: flex; align-items: center; gap: 0.5rem;">
                <input type="range" id="anim-speed" min="0.5" max="3" step="0.25" value="1" style="width: 100px;">
                <span id="speed-val">1x</span>
              </label>
            </div>
          </div>
        </div>

        <!-- State Diagram -->
        <div class="card" style="padding: 2rem; min-height: 500px; position: relative;">
          <div id="state-diagram" style="width: 100%; height: 480px; position: relative;"></div>

          <!-- Legend -->
          <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-primary);">
            <h4 style="margin-bottom: 1rem; color: var(--fg-secondary);">Legend</h4>
            <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; font-size: 0.85rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: var(--accent-primary); box-shadow: 0 0 8px var(--accent-primary);"></div>
                <span>Current State</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: var(--accent-primary-dim); border: 2px solid var(--accent-primary);"></div>
                <span>Visited</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 20px; height: 20px; border-radius: 50%; background: var(--bg-tertiary); border: 1px solid var(--border-primary);"></div>
                <span>Unvisited</span>
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem;">
                <svg width="20" height="20" viewBox="0 0 20 20"><line x1="2" y1="10" x2="18" y2="10" stroke="var(--accent-primary)" stroke-width="2" marker-end="url(#arrow)"/></svg>
                <span>Valid Transition</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Event Log -->
        <div class="card" style="margin-top: 2rem; padding: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <h3 style="display: flex; align-items: center; gap: 0.5rem;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-primary);">
                <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"></path>
              </svg>
              Event Log
            </h3>
            <button id="clear-log" class="btn btn-ghost btn-sm">Clear</button>
          </div>
          <div id="event-log" style="font-family: var(--font-mono); font-size: 0.8rem; line-height: 1.8; max-height: 200px; overflow-y: auto; background: var(--bg-tertiary); border: 1px solid var(--border-primary); border-radius: var(--radius-md); padding: 1rem; color: var(--fg-secondary);"></div>
        </div>

        <!-- State Details Panel -->
        <div class="card" style="margin-top: 1.5rem; padding: 1.5rem;">
          <h3 id="detail-title" style="margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem;">
            <span id="detail-state-badge" class="tag tag-primary">CLOSED</span>
            State Details
          </h3>
          <div id="detail-content" style="font-family: var(--font-mono); font-size: 0.85rem; line-height: 1.8; color: var(--fg-secondary);">
            <p>Click a state in the diagram to see details.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function() {
      // --- TCP State Machine Definition (RFC 793) ---
      const states = {
        CLOSED: { x: 50, y: 50, color: '#6b7280' },
        LISTEN: { x: 50, y: 50, color: '#00d47e' },
        SYN_SENT: { x: 50, y: 350, color: '#ffb800' },
        SYN_RCVD: { x: 350, y: 50, color: '#ffb800' },
        ESTABLISHED: { x: 350, y: 200, color: '#00d47e' },
        FIN_WAIT_1: { x: 650, y: 50, color: '#ff3d71' },
        FIN_WAIT_2: { x: 650, y: 200, color: '#ff3d71' },
        CLOSE_WAIT: { x: 350, y: 350, color: '#ff3d71' },
        LAST_ACK: { x: 650, y: 350, color: '#ff3d71' },
        TIME_WAIT: { x: 950, y: 200, color: '#00b4ff' },
        CLOSING: { x: 950, y: 50, color: '#ff3d71' }
      };

      const transitions = [
        // CLOSED
        { from: 'CLOSED', to: 'LISTEN', event: 'Passive Open', packet: '—', direction: 'server' },
        { from: 'CLOSED', to: 'SYN_SENT', event: 'Active Open', packet: 'SYN', direction: 'client' },

        // LISTEN
        { from: 'LISTEN', to: 'SYN_RCVD', event: 'Recv SYN', packet: 'SYN', direction: 'server' },
        { from: 'LISTEN', to: 'SYN_SENT', event: 'Active Open', packet: 'SYN', direction: 'client' },
        { from: 'LISTEN', to: 'CLOSED', event: 'Close', packet: '—', direction: 'server' },

        // SYN_SENT
        { from: 'SYN_SENT', to: 'SYN_RCVD', event: 'Recv SYN', packet: 'SYN', direction: 'client' },
        { from: 'SYN_SENT', to: 'ESTABLISHED', event: 'Recv SYN+ACK', packet: 'SYN+ACK', direction: 'client' },
        { from: 'SYN_SENT', to: 'CLOSED', event: 'Timeout/Close', packet: '—', direction: 'client' },

        // SYN_RCVD
        { from: 'SYN_RCVD', to: 'ESTABLISHED', event: 'Recv ACK', packet: 'ACK', direction: 'server' },
        { from: 'SYN_RCVD', to: 'LISTEN', event: 'Recv RST', packet: 'RST', direction: 'server' },
        { from: 'SYN_RCVD', to: 'FIN_WAIT_1', event: 'Close', packet: 'FIN', direction: 'server' },

        // ESTABLISHED
        { from: 'ESTABLISHED', to: 'FIN_WAIT_1', event: 'Active Close', packet: 'FIN', direction: 'client' },
        { from: 'ESTABLISHED', to: 'CLOSE_WAIT', event: 'Passive Close', packet: 'FIN', direction: 'server' },

        // FIN_WAIT_1
        { from: 'FIN_WAIT_1', to: 'FIN_WAIT_2', event: 'Recv ACK', packet: 'ACK', direction: 'client' },
        { from: 'FIN_WAIT_1', to: 'CLOSING', event: 'Recv FIN', packet: 'FIN', direction: 'client' },
        { from: 'FIN_WAIT_1', to: 'TIME_WAIT', event: 'Recv FIN+ACK', packet: 'FIN+ACK', direction: 'client' },

        // FIN_WAIT_2
        { from: 'FIN_WAIT_2', to: 'TIME_WAIT', event: 'Recv FIN', packet: 'FIN', direction: 'client' },

        // CLOSE_WAIT
        { from: 'CLOSE_WAIT', to: 'LAST_ACK', event: 'Close', packet: 'FIN', direction: 'server' },

        // LAST_ACK
        { from: 'LAST_ACK', to: 'CLOSED', event: 'Recv ACK', packet: 'ACK', direction: 'server' },

        // CLOSING
        { from: 'CLOSING', to: 'TIME_WAIT', event: 'Recv ACK', packet: 'ACK', direction: 'client' },

        // TIME_WAIT
        { from: 'TIME_WAIT', to: 'CLOSED', event: '2*MSL Timeout', packet: '—', direction: 'client' },
      ];

      // --- State Details ---
      const stateDetails = {
        CLOSED: {
          description: 'Initial state. No connection exists. Awaiting open request.',
          role: 'Both',
          actions: ['Passive Open → LISTEN', 'Active Open → SYN_SENT'],
          packets: 'None',
          timeout: 'None'
        },
        LISTEN: {
          description: 'Server awaiting incoming connection. Passive open completed.',
          role: 'Server',
          actions: ['Recv SYN → SYN_RCVD', 'Active Open → SYN_SENT', 'Close → CLOSED'],
          packets: 'SYN (in), SYN+ACK (out)',
          timeout: 'None'
        },
        SYN_SENT: {
          description: 'Client sent SYN, awaiting SYN+ACK. Active open in progress.',
          role: 'Client',
          actions: ['Recv SYN+ACK → ESTABLISHED', 'Recv SYN → SYN_RCVD', 'Timeout → CLOSED'],
          packets: 'SYN (out), SYN+ACK (in)',
          timeout: 'Retransmit SYN (exponential backoff)'
        },
        SYN_RCVD: {
          description: 'Server received SYN, sent SYN+ACK, awaiting ACK. Simultaneous open possible.',
          role: 'Server',
          actions: ['Recv ACK → ESTABLISHED', 'Recv RST → LISTEN', 'Close → FIN_WAIT_1'],
          packets: 'SYN (in), SYN+ACK (out), ACK (in)',
          timeout: 'Retransmit SYN+ACK'
        },
        ESTABLISHED: {
          description: 'Connection open. Bidirectional data transfer. Normal operating state.',
          role: 'Both',
          actions: ['Active Close → FIN_WAIT_1', 'Passive Close → CLOSE_WAIT'],
          packets: 'Data, ACK, PSH, URG',
          timeout: 'Keepalive (if enabled)'
        },
        FIN_WAIT_1: {
          description: 'Active close initiated. Sent FIN, awaiting ACK or FIN.',
          role: 'Client',
          actions: ['Recv ACK → FIN_WAIT_2', 'Recv FIN → CLOSING', 'Recv FIN+ACK → TIME_WAIT'],
          packets: 'FIN (out), ACK/FIN (in)',
          timeout: 'Retransmit FIN'
        },
        FIN_WAIT_2: {
          description: 'Received ACK for our FIN. Awaiting peer\'s FIN.',
          role: 'Client',
          actions: ['Recv FIN → TIME_WAIT'],
          packets: 'FIN (in), ACK (out)',
          timeout: 'None (indefinite wait)'
        },
        CLOSE_WAIT: {
          description: 'Passive close. Received FIN, sent ACK. Application must close.',
          role: 'Server',
          actions: ['Close → LAST_ACK'],
          packets: 'FIN (in), ACK (out)',
          timeout: 'None (application must act)'
        },
        LAST_ACK: {
          description: 'Sent FIN, awaiting final ACK. Connection nearly closed.',
          role: 'Server',
          actions: ['Recv ACK → CLOSED'],
          packets: 'FIN (out), ACK (in)',
          timeout: 'Retransmit FIN'
        },
        CLOSING: {
          description: 'Simultaneous close. Both sides sent FIN, awaiting ACK for our FIN.',
          role: 'Both',
          actions: ['Recv ACK → TIME_WAIT'],
          packets: 'FIN (out), FIN (in), ACK (in)',
          timeout: 'Retransmit FIN'
        },
        TIME_WAIT: {
          description: 'Connection closed. Waiting 2*MSL to ensure peer received final ACK. Prevents delayed segments.',
          role: 'Client',
          actions: ['2*MSL Timeout → CLOSED'],
          packets: 'None',
          timeout: '2 * MSL (typically 60 seconds)'
        }
      };

      // --- State ---
      let currentState = 'CLOSED';
      let visitedStates = new Set(['CLOSED']);
      let animationSpeed = 1;
      let autoAnimate = true;
      let animationQueue = [];

      // --- DOM Elements ---
      const container = document.getElementById('state-diagram');
      const detailTitle = document.getElementById('detail-title');
      const detailBadge = document.getElementById('detail-state-badge');
      const detailContent = document.getElementById('detail-content');
      const eventLog = document.getElementById('event-log');
      const speedVal = document.getElementById('speed-val');
      const animSpeed = document.getElementById('anim-speed');

      // --- Render State Diagram ---
      function renderDiagram() {
        container.innerHTML = '';

        // Draw transitions (lines)
        const svgNS = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(svgNS, 'svg');
        svg.setAttribute('width', '100%');
        svg.setAttribute('height', '100%');
        svg.style.position = 'absolute';
        svg.style.top = '0';
        svg.style.left = '0';
        svg.style.pointerEvents = 'none';
        svg.innerHTML = `
          <defs>
            <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L9,3 Z" fill="var(--border-primary)" />
            </marker>
            <marker id="arrow-active" markerWidth="10" markerHeight="10" refX="8" refY="3" orient="auto" markerUnits="strokeWidth">
              <path d="M0,0 L0,6 L9,3 Z" fill="var(--accent-primary)" />
            </marker>
          </defs>
        `;

        transitions.forEach(t => {
          const from = states[t.from];
          const to = states[t.to];
          if (!from || !to) return;

          const line = document.createElementNS(svgNS, 'line');
          line.setAttribute('x1', from.x);
          line.setAttribute('y1', from.y);
          line.setAttribute('x2', to.x);
          line.setAttribute('y2', to.y);
          line.setAttribute('stroke', 'var(--border-primary)');
          line.setAttribute('stroke-width', '2');
          line.setAttribute('marker-end', 'url(#arrow)');
          line.setAttribute('stroke-dasharray', '8,4');
          svg.appendChild(line);
        });

        container.appendChild(svg);

        // Draw states
        Object.entries(states).forEach(([name, pos]) => {
          const el = document.createElement('div');
          el.className = 'state-node';
          el.dataset.state = name;
          el.style.cssText = `
            position: absolute;
            left: ${pos.x}px;
            top: ${pos.y}px;
            transform: translate(-50%, -50%);
            width: 120px;
            cursor: pointer;
            transition: all 0.2s ease;
            z-index: 10;
          `;

          const isCurrent = name === currentState;
          const isVisited = visitedStates.has(name);
          const isValidNext = transitions.some(t => t.from === currentState && t.to === name);

          let bg, border, shadow;
          if (isCurrent) {
            bg = 'var(--accent-primary-dim)';
            border = '3px solid var(--accent-primary)';
            shadow = '0 0 20px rgba(0, 212, 126, 0.4)';
          } else if (isVisited) {
            bg = 'var(--accent-primary-dim)';
            border = '2px solid var(--accent-primary)';
            shadow = 'none';
          } else {
            bg = 'var(--bg-tertiary)';
            border = '2px solid var(--border-primary)';
            shadow = 'none';
          }

          if (isValidNext && autoAnimate) {
            border = '2px dashed var(--accent-primary)';
            shadow = '0 0 12px rgba(0, 212, 126, 0.3)';
          }

          el.innerHTML = `
            <div style="
              width: 100%;
              padding: 1rem;
              background: ${bg};
              border: ${border};
              border-radius: var(--radius-lg);
              text-align: center;
              box-shadow: ${shadow};
              font-family: var(--font-mono);
              font-size: 0.8rem;
              font-weight: 600;
              color: ${isCurrent || isVisited ? 'var(--accent-primary)' : 'var(--fg-primary)'};
              position: relative;
            ">
              ${name}
              ${isCurrent ? '<div style="position:absolute;top:-4px;right:-4px;width:10px;height:10px;background:var(--accent-primary);border-radius:50%;animation:pulse 1.5s ease-in-out infinite;"></div>' : ''}
              ${isVisited && !isCurrent ? '<div style="position:absolute;bottom:-4px;right:-4px;width:8px;height:8px;background:var(--accent-primary);border-radius:50%;"></div>' : ''}
            </div>
          `;

          el.addEventListener('click', () => showStateDetails(name));
          el.addEventListener('mouseenter', () => {
            if (!isCurrent) {
              el.querySelector('div').style.borderColor = 'var(--accent-primary)';
            }
          });
          el.addEventListener('mouseleave', () => {
            if (!isCurrent) {
              el.querySelector('div').style.borderColor = isVisited ? 'var(--accent-primary)' : 'var(--border-primary)';
            }
          });

          container.appendChild(el);
        });

        // Add pulse animation style
        if (!document.getElementById('pulse-style')) {
          const style = document.createElement('style');
          style.id = 'pulse-style';
          style.textContent = `
            @keyframes pulse {
              0%, 100% { opacity: 1; transform: scale(1); }
              50% { opacity: 0.5; transform: scale(0.8); }
            }
            @media (prefers-reduced-motion: reduce) {
              @keyframes pulse { 0%, 100% { opacity: 1; } }
            }
          `;
          document.head.appendChild(style);
        }
      }

      // --- Show State Details ---
      function showStateDetails(name) {
        const d = stateDetails[name];
        if (!d) return;

        detailBadge.textContent = name;
        detailBadge.className = 'tag tag-primary';
        detailBadge.style.background = 'var(--accent-primary-dim)';
        detailBadge.style.color = 'var(--accent-primary)';

        const validNext = transitions.filter(t => t.from === name).map(t => t.to);
        const validPrev = transitions.filter(t => t.to === name).map(t => t.from);

        detailContent.innerHTML = `
          <div style="margin-bottom: 1rem;">
            <strong style="color: var(--fg-primary);">Description:</strong>
            <p style="margin-top: 0.5rem;">${d.description}</p>
          </div>
          <div style="margin-bottom: 1rem;">
            <strong style="color: var(--fg-primary);">Role:</strong> ${d.role}
          </div>
          <div style="margin-bottom: 1rem;">
            <strong style="color: var(--fg-primary);">Typical Packets:</strong> ${d.packets}
          </div>
          <div style="margin-bottom: 1rem;">
            <strong style="color: var(--fg-primary);">Timeout Behavior:</strong> ${d.timeout}
          </div>
          <div style="margin-bottom: 1rem;">
            <strong style="color: var(--fg-primary);">Valid Transitions:</strong>
            <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
              ${d.actions.map(a => `
                <span class="tag ${validNext.some(n => a.includes(n)) ? 'tag-accent' : ''}" style="font-size: 0.75rem;">${a}</span>
              `).join('')}
            </div>
          </div>
          <div>
            <strong style="color: var(--fg-primary);">From States:</strong>
            <div style="margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
              ${validPrev.length ? validPrev.map(s => `<span class="tag" style="font-size: 0.75rem;">${s}</span>`).join('') : '<span class="tag" style="font-size: 0.75rem; color: var(--fg-muted);">(initial)</span>'}
            </div>
          </div>
        `;
      }

      // --- Event Log ---
      function logEvent(message, type = 'info') {
        const colors = { info: 'var(--fg-secondary)', success: 'var(--accent-primary)', warning: 'var(--accent-warning)', error: 'var(--accent-secondary)' };
        const time = new Date().toLocaleTimeString();
        const entry = document.createElement('div');
        entry.style.cssText = `color: ${colors[type]}; border-left: 2px solid ${colors[type]}; padding-left: 0.75rem; margin: 0.25rem 0;`;
        entry.innerHTML = `<span style="color: var(--fg-muted);">[${time}]</span> ${message}`;
        eventLog.insertBefore(entry, eventLog.firstChild);
        // Keep last 50 entries
        while (eventLog.children.length > 50) eventLog.removeChild(eventLog.lastChild);
      }

      function clearLog() {
        eventLog.innerHTML = '';
        logEvent('Log cleared', 'info');
      }

      // --- State Transitions ---
      function transition(toState, eventName, packet) {
        const fromState = currentState;
        const transition = transitions.find(t => t.from === fromState && t.to === toState);
        if (!transition) {
          logEvent(`✗ Invalid transition: ${fromState} → ${toState}`, 'error');
          return false;
        }

        currentState = toState;
        visitedStates.add(toState);

        const dirIcon = transition.direction === 'client' ? '→' : '←';
        logEvent(`${fromState} ${dirIcon} ${toState} | ${eventName} | Packet: ${packet}`, 'success');

        renderDiagram();
        showStateDetails(toState);
        return true;
      }

      // --- Button Handlers ---
      document.getElementById('btn-active-open').addEventListener('click', () => {
        if (currentState === 'CLOSED') transition('SYN_SENT', 'Active Open (send SYN)', 'SYN');
        else if (currentState === 'LISTEN') transition('SYN_SENT', 'Active Open (send SYN)', 'SYN');
        else logEvent(`✗ Active Open not valid from ${currentState}`, 'warning');
      });

      document.getElementById('btn-passive-open').addEventListener('click', () => {
        if (currentState === 'CLOSED') transition('LISTEN', 'Passive Open (bind+listen)', '—');
        else logEvent(`✗ Passive Open not valid from ${currentState}`, 'warning');
      });

      document.getElementById('btn-send-fin').addEventListener('click', () => {
        if (currentState === 'ESTABLISHED') transition('FIN_WAIT_1', 'Active Close (send FIN)', 'FIN');
        else if (currentState === 'SYN_RCVD') transition('FIN_WAIT_1', 'Close (send FIN)', 'FIN');
        else if (currentState === 'CLOSE_WAIT') transition('LAST_ACK', 'Close (send FIN)', 'FIN');
        else logEvent(`✗ Send FIN not valid from ${currentState}`, 'warning');
      });

      document.getElementById('btn-recv-fin').addEventListener('click', () => {
        if (currentState === 'ESTABLISHED') transition('CLOSE_WAIT', 'Passive Close (recv FIN)', 'FIN');
        else if (currentState === 'FIN_WAIT_1') transition('CLOSING', 'Recv FIN (simultaneous close)', 'FIN');
        else if (currentState === 'FIN_WAIT_2') transition('TIME_WAIT', 'Recv FIN', 'FIN');
        else if (currentState === 'SYN_RCVD') transition('FIN_WAIT_1', 'Recv FIN (unusual)', 'FIN');
        else logEvent(`✗ Receive FIN not valid from ${currentState}`, 'warning');
      });

      document.getElementById('btn-timeout').addEventListener('click', () => {
        if (currentState === 'SYN_SENT') transition('CLOSED', 'Connection Timeout', '—');
        else if (currentState === 'TIME_WAIT') transition('CLOSED', '2*MSL Timeout (60s)', '—');
        else logEvent(`✗ Timeout not applicable in ${currentState}`, 'warning');
      });

      document.getElementById('btn-reset').addEventListener('click', () => {
        currentState = 'CLOSED';
        visitedStates = new Set(['CLOSED']);
        logEvent('State machine reset to CLOSED', 'info');
        renderDiagram();
        showStateDetails('CLOSED');
      });

      // --- Auto-animate common paths ---
      function autoDemo() {
        if (!autoAnimate) return;

        // If at start, show passive then active open
        if (currentState === 'CLOSED' && visitedStates.size === 1) {
          setTimeout(() => {
            transition('LISTEN', 'Passive Open', '—');
            setTimeout(() => {
              transition('SYN_RCVD', 'Recv SYN', 'SYN');
              setTimeout(() => {
                transition('ESTABLISHED', 'Recv ACK', 'ACK');
              }, 1500 / animationSpeed);
            }, 1500 / animationSpeed);
          }, 1000 / animationSpeed);
        }
      }

      // --- Controls ---
      document.getElementById('auto-animate').addEventListener('change', e => {
        autoAnimate = e.target.checked;
      });

      animSpeed.addEventListener('input', e => {
        animationSpeed = parseFloat(e.target.value);
        speedVal.textContent = animationSpeed + 'x';
      });

      document.getElementById('clear-log').addEventListener('click', clearLog);

      // --- Initialize ---
      logEvent('TCP State Machine initialized (RFC 793)', 'info');
      logEvent('Click buttons to simulate transitions, or click states for details', 'info');
      renderDiagram();
      showStateDetails('CLOSED');

      // Start auto demo after a moment
      setTimeout(autoDemo, 1000);
    })();
  </script>
</BaseLayout>